#!/bin/sh
# Validates the commit message's first line against this repo's semantic
# commit convention. See CLAUDE.md for the full convention.
#
# Enable once per clone/session:
#   git config core.hooksPath .githooks

commit_msg_file="$1"
first_line=$(head -n1 "$commit_msg_file")

valid_types='feat|fix|refactor|test|docs|chore|decision'

if ! printf '%s' "$first_line" | grep -qE "^(${valid_types}): .+"; then
    echo "Commit message rejeitada pelo hook commit-msg." >&2
    echo "" >&2
    echo "Primeira linha recebida:" >&2
    echo "  ${first_line}" >&2
    echo "" >&2
    echo "Formato esperado: <tipo>: <resumo curto, no imperativo>" >&2
    echo "Tipos válidos: feat, fix, refactor, test, docs, chore, decision" >&2
    echo "" >&2
    echo "Ver CLAUDE.md para a convenção completa." >&2
    exit 1
fi

exit 0
